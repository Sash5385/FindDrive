{
  "packageId": "ua.in.finddrive.app",
  "host": "finddrive.in.ua",
  "name": "FindDrive — Знайди інструктора",
  "launcherName": "FindDrive",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#1a7a4a",
  "themeColorDark": "#0d4a2a",
  "navigationColor": "#1a7a4a",
  "navigationColorDark": "#0d4a2a",
  "navigationDividerColor": "#1a7a4a",
  "navigationDividerColorDark": "#0d4a2a",
  "backgroundColor": "#f0f2f0",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://finddrive.in.ua/logo.png",
  "maskableIconUrl": "https://finddrive.in.ua/logo.png",
  "splashScreenFadeOutDuration": 300,
  "appVersion": "1",
  "appVersionCode": 1,
  "signingKey": { "path": "./upload.keystore", "alias": "upload" },
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": { "enabled": true }
  },
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "enableSiteSettingsShortcut": true,
  "webManifestUrl": "https://finddrive.in.ua/manifest.json",
  "fullScopeUrl": "https://finddrive.in.ua/",
  "minSdkVersion": 21,
  "shortcuts": []
}
