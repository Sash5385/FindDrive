rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Email у токені можна "присвоїти" неверифікованим акаунтом (email/пароль),
    // тож доступ за email — лише при email_verified == true.
    function emailIs(e) {
      return request.auth != null
          && request.auth.token.email_verified == true
          && e != null
          && e != ''
          && request.auth.token.email == e;
    }

    function isAdmin() {
      return emailIs('sash5385@gmail.com');
    }

    function instrDoc(instrId) {
      return get(/databases/$(database)/documents/instructors/$(instrId)).data;
    }

    function isInstructor(instrId) {
      return request.auth != null
          && instrId != null
          && instrId != ''
          && (instrDoc(instrId).userId == request.auth.uid
              || emailIs(instrDoc(instrId).get('email', null)));
    }

    // Інструктор, зв'язаний з ID4Drive (id4Linked ставить лише адмін)
    function isLinkedInstr(instrId) {
      return instrId != null
          && instrId != ''
          && exists(/databases/$(database)/documents/instructors/$(instrId))
          && instrDoc(instrId).get('id4Linked', false) == true;
    }

    function schoolDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data;
    }

    function isSchoolOwner(schoolId) {
      return request.auth != null
          && schoolId != null
          && schoolId != ''
          && (schoolDoc(schoolId).userId == request.auth.uid
              || emailIs(schoolDoc(schoolId).get('email', null)));
    }

    // adminChats/{role}_{refId}: refId — uid учня, id інструктора або id школи.
    // Власник тредy — той, чий role+refId у документі відповідає поточному auth.
    function adminChatOwn(data) {
      return request.auth != null
          && ((data.role == 'student'    && data.refId == request.auth.uid)
              || (data.role == 'instructor' && isInstructor(data.refId))
              || (data.role == 'school'     && isSchoolOwner(data.refId)));
    }

    // rating/reviews рахує лише Cloud Function onReviewCreated.
    function freshRating() {
      return request.resource.data.get('rating', null) == null
          && request.resource.data.get('reviews', 0) == 0;
    }

    function ownOrNoUserId() {
      return request.resource.data.get('userId', null) == null
          || (request.auth != null && request.resource.data.userId == request.auth.uid);
    }

    match /instructors/{docId} {
      allow get: if isAdmin()
              || resource.data.status == 'approved'
              || (request.auth != null && resource.data.userId == request.auth.uid)
              || emailIs(resource.data.get('email', null));
      allow list: if isAdmin()
               || resource.data.status == 'approved'
               || (request.auth != null && resource.data.userId == request.auth.uid)
               || emailIs(resource.data.get('email', null));
      // Без авторизації дозволено свідомо (фолбек, коли email-провайдер недоступний).
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.get('id4Linked', false) != true
                    && request.resource.data.get('verified', false) != true
                    && freshRating()
                    && ownOrNoUserId();
      allow update: if isAdmin()
                 || (request.auth != null
                     && resource.data.userId == request.auth.uid
                     && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'id4Linked', 'verified', 'rating', 'reviews', 'userId']))
                 || (emailIs(resource.data.get('email', null))
                     && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'id4Linked', 'verified', 'rating', 'reviews', 'userId']))
                 || (resource.data.get('userId', null) == null
                     && emailIs(resource.data.get('email', null))
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId']))
                 // Школа надсилає запрошення інструктору — може змінити лише поле schoolInvite,
                 // і лише якщо сама володіє школою, на яку запрошує.
                 || (request.auth != null
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schoolInvite'])
                     && isSchoolOwner(request.resource.data.schoolInvite.schoolId))
                 // Школа може відв'язати інструктора зі свого складу (лише обнулити schoolId, лише свого).
                 || (request.auth != null
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schoolId'])
                     && request.resource.data.schoolId == null
                     && isSchoolOwner(resource.data.schoolId));
      allow delete: if isAdmin();
    }

    match /schools/{docId} {
      allow get: if isAdmin()
              || resource.data.status == 'approved'
              || (request.auth != null && resource.data.userId == request.auth.uid)
              || emailIs(resource.data.get('email', null));
      allow list: if isAdmin()
               || resource.data.status == 'approved'
               || (request.auth != null && resource.data.userId == request.auth.uid)
               || emailIs(resource.data.get('email', null));
      allow create: if request.resource.data.status == 'pending'
                    && freshRating()
                    && ownOrNoUserId();
      allow update: if isAdmin()
                 || (request.auth != null
                     && resource.data.userId == request.auth.uid
                     && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'rating', 'reviews', 'userId']))
                 || (emailIs(resource.data.get('email', null))
                     && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'rating', 'reviews', 'userId']))
                 || (resource.data.get('userId', null) == null
                     && emailIs(resource.data.get('email', null))
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId']));
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      // Публічний доступ прибрано — тут ПІБ/телефон/email клієнта й інструктора, точка зустрічі.
      // Анонімний перегляд зайнятих слотів реалізовано через окрему публічну колекцію bookingSlots
      // (без персональних даних), яку наповнює Cloud Function mirrorBookingSlot.
      allow read: if isAdmin()
               || (request.auth != null && resource.data.clientId == request.auth.uid)
               || isInstructor(resource.data.instructorId);
      allow create: if request.auth != null
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      // Для інструктора, зв'язаного з ID4Drive, пряме скасування клієнтом заборонене —
      // лише через callable cancelBooking (вікно 24 год + синхронізація з ID4).
      allow update: if request.auth != null
                    && resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'cancelled'
                    && !isLinkedInstr(resource.data.instructorId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy']);
      allow update: if isInstructor(resource.data.instructorId)
                    && !isLinkedInstr(resource.data.instructorId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'date', 'time', 'proposedDate', 'proposedTime']);
      // Для зв'язаного з ID4Drive інструктора — лише статус; перенесення (date/time) тільки в ID4Drive
      allow update: if isInstructor(resource.data.instructorId)
                    && isLinkedInstr(resource.data.instructorId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow update: if request.auth != null
                    && resource.data.clientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed']);
      allow delete: if isAdmin();
    }

    match /bookingSlots/{id} {
      // Публічний "зліпок" bookings без персональних даних — лише instructorId/date/time/duration/status.
      // Пише виключно Cloud Function mirrorBookingSlot через Admin SDK (обходить ці правила),
      // тому пряме клієнтське write заборонено.
      allow read: if true;
      allow write: if false;
    }

    function reviewableBooking(bookingId, instrId) {
      let b = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return b.clientId == request.auth.uid
          && b.instructorId == instrId
          && b.status == 'confirmed';
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // ID відгуку = ID бронювання → один відгук на бронь. Лише клієнт цієї броні,
      // лише по підтвердженому уроку, оцінка 1..5, текст до 2000.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['instrId','clientId','clientName','clientPhoto','rating','text','bookingId','createdAt'])
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.bookingId == reviewId
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.clientName is string
                    && request.resource.data.clientName.size() <= 100
                    && optStr(request.resource.data.get('clientPhoto', null), 300000)
                    && request.resource.data.createdAt == request.time
                    && reviewableBooking(reviewId, request.resource.data.instrId);
      allow update, delete: if isAdmin();
    }

    // Дошка оголошень: kind 'offer' (інструктор пропонує вільний слот) або
    // 'request' (учень шукає інструктора). Ліміт у 6 активних постів на автора
    // забезпечує Cloud Function (onBoardPostCreated), не правила.
    match /boardPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.kind in ['offer', 'request'];
      allow update, delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Автоматичні звіти про помилки з клієнта (window.onerror, unhandledrejection, _logErr).
    // Створити може будь-хто (лише з обмеженим набором полів і розмірів), читає/керує адмін.
    function optStr(v, n) { return v == null || (v is string && v.size() <= n); }
    match /errorLogs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(['code','context','message','stack','url','ua','version','fp','uid','email','status','createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.code is string && request.resource.data.code.size() <= 80
                    && request.resource.data.context is string && request.resource.data.context.size() <= 120
                    && request.resource.data.message is string && request.resource.data.message.size() <= 500
                    && optStr(request.resource.data.get('stack', null), 1500)
                    && optStr(request.resource.data.get('url', null), 300)
                    && optStr(request.resource.data.get('ua', null), 200)
                    && optStr(request.resource.data.get('version', null), 20)
                    && optStr(request.resource.data.get('fp', null), 250)
                    && optStr(request.resource.data.get('uid', null), 128)
                    && optStr(request.resource.data.get('email', null), 200);
      allow read, update, delete: if isAdmin();
    }

    match /problems/{problemId} {
      allow create: if request.resource.data.status == 'new'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 3000;
      allow read, update, delete: if isAdmin();
    }

    // Учасник чату: учень за uid, інструктор за uid або верифікованим email.
    function chatMember(c) {
      return request.auth != null
          && (c.studentId == request.auth.uid
              || (c.get('instrUserId', null) != null && c.instrUserId == request.auth.uid)
              || emailIs(c.get('instrEmail', null)));
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    // chatId = <instrId>_<studentId>; поля інструктора мають збігатися з його профілем.
    function validNewChat(chatId, d) {
      let instr = instrDoc(d.instrId);
      return d.instrId is string
          && d.studentId is string
          && chatId == d.instrId + '_' + d.studentId
          && d.get('instrUserId', null) == instr.get('userId', null)
          && d.get('instrEmail', '') == instr.get('email', '')
          && (d.studentId == request.auth.uid || isInstructor(d.instrId));
    }

    match /chats/{chatId} {
      allow get, list: if chatMember(resource.data);
      allow create: if request.auth != null && validNewChat(chatId, request.resource.data);
      // Учасники/прив'язку не можна переписати; поля інструктора — лише на актуальні з профілю.
      allow update: if chatMember(resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['instrId', 'studentId'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['instrUserId', 'instrEmail'])
                        || (request.resource.data.get('instrUserId', null) == instrDoc(resource.data.instrId).get('userId', null)
                            && request.resource.data.get('instrEmail', '') == instrDoc(resource.data.instrId).get('email', '')));
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if chatMember(chatData(chatId));
      allow create: if chatMember(chatData(chatId))
                    && request.resource.data.keys().hasOnly(['text', 'from', 'uid', 'senderName', 'at'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.from in ['student', 'instructor']
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && optStr(request.resource.data.get('senderName', null), 200)
                    && request.resource.data.at == request.time;
    }

    // Переписка адміна з конкретним учнем/інструктором/школою — окрема від chats,
    // бо там завжди рівно два учасники: адмін і одна людина (не пара учень-інструктор).
    match /adminChats/{chatId} {
      allow get, list: if isAdmin() || adminChatOwn(resource.data);
      // Створити тред може і адмін (пише першим), і сама людина (пише першою) —
      // але лише "про себе", тобто role+refId мають збігатись із запитувачем.
      allow create: if isAdmin() || adminChatOwn(request.resource.data);
      allow update: if isAdmin() || adminChatOwn(resource.data);
    }
    match /adminChats/{chatId}/messages/{msgId} {
      allow read, create: if isAdmin() || adminChatOwn(get(/databases/$(database)/documents/adminChats/$(chatId)).data);
    }
  }
}
